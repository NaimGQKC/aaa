# --- Runtime mode -----------------------------------------------------------
# Provider for OCR + LLM extraction:
#   local   -> fully offline: pdfplumber OCR + deterministic label-based extraction
#              (no API keys needed; used for dev, demos, CI and the eval harness)
#   mistral -> Mistral La Plateforme (EU data residency by default; enable ZDR + DPA
#              on your org). Requires MISTRAL_API_KEY.
DD_PROVIDER=local

# --- Mistral (EU-sovereign API phase) --------------------------------------
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_LLM_MODEL=mistral-large-2512
MISTRAL_SMALL_MODEL=ministral-8b-latest   # classifier / cheap sub-tasks

# --- Database ---------------------------------------------------------------
# docker-compose default; override for Supabase / Scaleway Managed PG.
DATABASE_URL=postgresql+psycopg://dd:dd@localhost:5432/dd
# Set to a file path to use SQLite instead (zero-infra dev mode):
#   DATABASE_URL=sqlite:///./data/dd.sqlite3

# --- Object storage (S3-compatible) ----------------------------------------
# local  -> store under ./data/storage (dev default)
# s3     -> MinIO (compose) / Scaleway Object Storage (prod)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=dd
S3_SECRET_KEY=dd-secret-dd
S3_BUCKET=dd-artifacts
S3_REGION=fr-par

# --- API --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Compliance -------------------------------------------------------------
# AI Act Article 26(6): retention floor is 6 months; configurable upwards only.
AUDIT_LOG_RETENTION_DAYS=183
